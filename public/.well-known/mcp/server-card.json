{
  "serverInfo": {
    "name": "ScrapeAgent",
    "version": "1.0.0"
  },
  "authentication": {
    "required": false
  },
  "tools": [
    {
      "name": "scrape_url",
      "description": "Scrape a public URL and return its text content, raw HTML, or list of links. Costs $0.01 USDC per call via x402 payment. No API key needed — payment is the auth.",
      "inputSchema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "description": "Publicly accessible URL to scrape"
          },
          "format": {
            "type": "string",
            "enum": ["text", "html", "links"],
            "description": "Output format (default: text)"
          }
        }
      }
    }
  ],
  "resources": [],
  "prompts": []
}
