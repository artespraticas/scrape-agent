{
  "rewrites": [
    { "source": "/openapi.json", "destination": "/api/openapi.json" },
    { "source": "/mcp", "destination": "/api/mcp.js" },
    { "source": "/.well-known/mcp/server-card.json", "destination": "/public/.well-known/mcp/server-card.json" }
  ],
  "functions": {
    "api/mcp.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-PAYMENT, PAYMENT-SIGNATURE, MCP-Session-Id" }
      ]
    }
  ]
}
